{
  "FeiHouEasyH3LoraStack": {
    "display_name": "Load LoRA (Bypass, Model Only) (Debug)",
    "description": "Dynamic LoRA stack used by the FeiHou Easy H3 Loader.",
    "inputs": {
      "optional_lora_stack": { "name": "Optional LoRA stack" }
    },
    "outputs": {
      "0": { "name": "LoRA stack" }
    }
  },
  "FeiHouEasyH3Loader": {
    "display_name": "FeiHou Easy H3 Loader",
    "description": "Load MiniMax H3 transformers, text encoder, and video/audio VAEs.",
    "inputs": {
      "fl2va_model": { "name": "FL2VA model" },
      "ref2va_model": { "name": "REF2VA model" },
      "text_encoder": { "name": "Text encoder" },
      "video_vae": { "name": "Video VAE" },
      "audio_vae": { "name": "Audio VAE" },
      "lora_stack": { "name": "LoRA stack" },
      "custom_second_sampling_models": { "name": "Custom second-pass models" },
      "second_fl2va_model": { "name": "Second-pass FL2VA model" },
      "second_ref2va_model": { "name": "Second-pass REF2VA model" },
      "second_sampling_use_lora": { "name": "Use LoRA for second pass" }
    },
    "outputs": {
      "0": { "name": "H3 model bundle" }
    }
  },
  "FeiHouEasyH3ModelAdapter": {
    "display_name": "FeiHou Easy H3 Model Bridge",
    "description": "Build an H3 bundle from standard ComfyUI model, CLIP, and VAE connections.",
    "inputs": {
      "text_encoder": { "name": "Text encoder" },
      "video_vae": { "name": "Video VAE" },
      "audio_vae": { "name": "Audio VAE" },
      "fl2va_model": { "name": "FL2VA model" },
      "ref2va_model": { "name": "REF2VA model" }
    },
    "outputs": {
      "0": { "name": "H3 model bundle" }
    }
  },
  "FeiHouEasyH3": {
    "display_name": "ComfyUI-FeiHou-Easy-H3",
    "description": "MiniMax H3 generation with an embedded 9-image, 3-video, and 3-audio media gallery.",
    "inputs": {
      "h3_bundle": { "name": "H3 model bundle" },
      "mode": {
        "name": "Mode",
        "options": {
          "image": "I2V or First/Last Frame",
          "reference": "Reference-to-video"
        }
      },
      "prompt": { "name": "Prompt" },
      "resolution": { "name": "Resolution" },
      "aspect_ratio": { "name": "Aspect ratio" },
      "width": { "name": "Width" },
      "height": { "name": "Height" },
      "seconds": { "name": "Seconds" },
      "advanced": { "name": "Advanced options" },
      "fps": { "name": "Frame rate (FPS)" },
      "keyframe_role": {
        "name": "First/last frame setup",
        "options": {
          "first": "First frame priority",
          "last": "Last frame priority"
        }
      },
      "ref_image_size": { "name": "Reference image size (short edge)" },
      "reference_mention_mode": {
        "name": "@ reference mode",
        "options": {
          "filename": "By filename",
          "index": "By index"
        }
      },
      "prompt_optimizer_enabled": { "name": "Prompt optimization" },
      "prompt_optimizer_provider": { "name": "API service/model" },
      "prompt_optimizer_scene_guide": { "name": "Prompt Guide" }
    },
    "outputs": {
      "0": { "name": "Model" },
      "1": { "name": "Second sampling model" },
      "2": { "name": "H3 Context" }
    }
  },
  "FeiHouEasyH3Output": {
    "display_name": "FeiHou Easy H3 Output",
    "description": "Unpack conditioning, latent, VAEs, FPS, and prompt preview from H3 Context.",
    "inputs": {
      "h3_context": { "name": "H3 Context" }
    },
    "outputs": {
      "0": { "name": "Positive" },
      "1": { "name": "Latent" },
      "2": { "name": "Video VAE" },
      "3": { "name": "Audio VAE" },
      "4": { "name": "FPS" },
      "5": { "name": "Prompt inference output" }
    }
  },
  "FeiHouEasyH3PromptPreview": {
    "display_name": "FeiHou Easy H3 Prompt Preview",
    "description": "Preview the final expanded or media-inferred prompt.",
    "inputs": {
      "text": { "name": "Prompt inference output" }
    },
    "outputs": {
      "0": { "name": "Text" }
    }
  }
}
