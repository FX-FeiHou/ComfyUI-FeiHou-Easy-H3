          "image": "图生或首尾帧",
          "reference": "参考生视频"
        }
      },
      "prompt": { "name": "提示词" },
      "resolution": { "name": "分辨率" },
      "aspect_ratio": { "name": "宽高比" },
      "width": { "name": "宽度" },
      "height": { "name": "高度" },
