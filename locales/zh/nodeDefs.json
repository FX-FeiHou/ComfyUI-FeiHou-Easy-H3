      "name": "自动时长对齐",
      "options": {"off": "关闭", "audio": "参考音频对齐", "video": "参考视频对齐"}
    },
    "seconds": { "name": "秒数" },
      "advanced": { "name": "高级选项" },
      "fps": { "name": "帧率（FPS）" },
      "keyframe_role": {
        "name": "首尾帧设置",
        "options": {
          "first": "首帧优先",
          "last": "尾帧优先"
        }
      },
      "ref_image_size": { "name": "参考图尺寸（短边）", "options": { "match": "匹配生成分辨率" } },
      "reference_mention_mode": {
        "name": "@引用方式",
        "options": {
          "filename": "按文件名",
          "index": "按序号"
        }
      },
      "prompt_optimizer_enabled": { "name": "提示词优化" },
      "prompt_optimizer_provider": { "name": "API 服务/模型" },
      "prompt_optimizer_scene_guide": { "name": "提示词方案" }
    },
    "outputs": {
      "0": { "name": "模型" },
      "1": { "name": "二次采样模型" },
      "2": { "name": "H3 Context" }
    }
  },
